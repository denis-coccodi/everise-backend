{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Production Worker. The name must match the Worker in Cloudflare exactly:
  // a different name makes `wrangler deploy` create a new Worker with an empty database.
  "name": "be-prod",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],

  // Served by Cloudflare before the Worker runs, e.g. /assets/images/avatar-profile.png
  "assets": {"directory": "./public", "binding": "ASSETS"},

  // The database: one Durable Object with SQLite-backed storage (free plan).
  "durable_objects": {
    "bindings": [
      {"name": "DB", "class_name": "EveriseDb"},
      // The live updates' WebSockets (src/live/live-hub.ts).
      {"name": "LIVE", "class_name": "LiveHub"},
      // The Party Finder listings read from xivpf.com (src/party-finder).
      {"name": "PARTY_FINDER", "class_name": "PartyFinderHub"}
    ]
  },
  // Never edit or remove applied migrations; add new ones.
  "migrations": [
    {"tag": "v1", "new_sqlite_classes": ["EveriseDb"]},
    {"tag": "v2", "new_sqlite_classes": ["LiveHub"]},
    {"tag": "v3", "new_sqlite_classes": ["PartyFinderHub"]}
  ],

  // Workers AI, for the Waking Sands characters (src/waking-sands). On the
  // Workers Free plan it stops at 10,000 Neurons a day instead of billing.
  "ai": {"binding": "AI"},

  // The uploaded images' bytes (src/files). R2 free tier: 10 GB stored, 1M
  // writes and 10M reads a month; past it, R2 bills per use.
  "r2_buckets": [{"binding": "IMAGES", "bucket_name": "everise-images"}],

  // Production values. `wrangler dev` overrides them with .dev.vars.
  // JWT_SECRET_KEY is a secret, set once with `wrangler secret put JWT_SECRET_KEY`.
  "vars": {
    // The site users open: the frontend forwards /api here over a service binding
    // and serves the default avatar (BASE_URL/assets/images/avatar-profile.png).
    // Email links, sign-in return addresses and upload URLs are built from it.
    "BASE_URL": "https://everise.dev",
    // The site's earlier address: pictures and uploads saved under it are read
    // as BASE_URL ones (src/site-urls.ts).
    "LEGACY_BASE_URLS": "https://prod.everisefc.workers.dev",
    // Only the deployed frontend. Requests carry the auth cookie, so any origin
    // listed here can act as a logged-in user: never add localhost to production.
    // Browsers now reach the API same-origin through the frontend; this stays for
    // frontend builds that still call the API directly.
    "CORS_ORIGINS": "https://everise.dev,https://prod.everisefc.workers.dev",
    "COOKIE_SAME_SITE": "none",
    "JWT_ISSUER": "https://everisefc.com",
    "JWT_SECONDS_TO_EXPIRATION": "86400",
    // The EVERISE Discord server, whose widget the home page shows.
    "DISCORD_GUILD_ID": "1019343461960384623",
    // The Workers AI Neurons the Waking Sands may spend a day (a reply costs
    // a few). With staging's 1,500 this stays under the account's free 10,000.
    "WAKING_SANDS_DAILY_NEURONS": "8000",
    // The MB everyone's uploads may keep in R2. With staging's 1,024 this
    // stays under the account's free 10 GB.
    "UPLOAD_STORAGE_MB": "9216"
    // TURNSTILE_SECRET_KEY (the bot check) is a secret:
    // `wrangler secret put TURNSTILE_SECRET_KEY`.
  },

  "observability": {"enabled": true},

  "dev": {"port": 8080},

  // The API's own address (browsers reach it through the site's /api). The
  // workers.dev address stays on for scripts, CI and links saved before.
  "routes": [{"pattern": "apis.everise.dev", "custom_domain": true}],
  "workers_dev": true,

  // `wrangler deploy --env staging` deploys a separate Worker, "be-staging",
  // with its own Durable Object and so its own data. Bindings and vars are not
  // inherited from the top level, so they are repeated here.
  // Its JWT_SECRET_KEY is set once with `wrangler secret put JWT_SECRET_KEY --env staging`.
  "env": {
    "staging": {
      // Set explicitly: the default would be "be-prod-staging".
      "name": "be-staging",
      // Not inherited either.
      "routes": [
        {"pattern": "staging.apis.everise.dev", "custom_domain": true}
      ],
      "workers_dev": true,
      "durable_objects": {
        "bindings": [
          {"name": "DB", "class_name": "EveriseDb"},
          {"name": "LIVE", "class_name": "LiveHub"},
          {"name": "PARTY_FINDER", "class_name": "PartyFinderHub"}
        ]
      },
      "ai": {"binding": "AI"},
      "r2_buckets": [
        {"binding": "IMAGES", "bucket_name": "everise-images-staging"}
      ],
      "vars": {
        "BASE_URL": "https://staging.everise.dev",
        "LEGACY_BASE_URLS": "https://staging.everisefc.workers.dev",
        // localhost is allowed here so a local frontend can use staging; staging only holds test data.
        "CORS_ORIGINS": "https://staging.everise.dev,https://staging.everisefc.workers.dev,http://localhost:4200,http://127.0.0.1:4200",
        "COOKIE_SAME_SITE": "none",
        "JWT_ISSUER": "https://everisefc.com",
        "JWT_SECONDS_TO_EXPIRATION": "86400",
        // The EVERISE Discord server, whose widget the home page shows.
        "DISCORD_GUILD_ID": "1019343461960384623",
        // Staging's share of the account's free Workers AI Neurons (see above).
        "WAKING_SANDS_DAILY_NEURONS": "1500",
        // Staging's share of the account's free 10 GB of R2 (see above).
        "UPLOAD_STORAGE_MB": "1024"
      }
    }
  }
}
