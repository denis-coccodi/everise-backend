{
  "extends": "./node_modules/gts/tsconfig-google.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "build",
    "typeRoots": ["src/types", "node_modules/@types"],
    "sourceMap": true,
    "esModuleInterop": true,
    "lib": ["ES2022"],
    "target": "ES2022",
    "types": ["node", "jest"],
    "skipLibCheck": true,
    "module": "commonjs",
    "moduleResolution": "bundler"
  },
  "include": ["src/**/*.ts", "__tests__/**/*.ts", "worker-configuration.d.ts"]
}
