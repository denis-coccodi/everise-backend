{
  "permissions": {
    "ask": [
      "Bash(gh workflow run deploy-production*)",
      "Bash(npx wrangler deploy*)",
      "Bash(wrangler deploy*)",
      "Bash(npm run deploy*)",
      "PowerShell(gh workflow run deploy-production*)",
      "PowerShell(npx wrangler deploy*)",
      "PowerShell(wrangler deploy*)",
      "PowerShell(npm run deploy*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.mjs\""
          }
        ]
      }
    ]
  }
}
