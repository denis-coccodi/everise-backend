{
  "name": "everise-backend",
  "version": "0.0.0",
  "description": "TypeScript backend for Everise, the Everise FC community site, running on Cloudflare Workers with a Durable Object database.",
  "author": "Marcus Vinicius Monteiro de Souza",
  "license": "MIT",
  "private": true,
  "files": [
    "src"
  ],
  "keywords": [
    "typescript",
    "cloudflare-workers",
    "durable-objects"
  ],
  "scripts": {
    "start": "wrangler dev",
    "postinstall": "wrangler types",
    "test": "jest --runInBand",
    "posttest": "npm run compile && npm run lint && npm run sizes",
    "deploy": "wrangler deploy",
    "format": "prettier --write .",
    "lint": "gts lint",
    "fix": "gts fix",
    "clean": "gts clean",
    "compile": "tsc --noEmit",
    "sizes": "node scripts/check-sizes.mjs"
  },
  "devDependencies": {
    "@faker-js/faker": "^7.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "dotenv": "^16.6.1",
    "dotenv-expand": "^9.0.0",
    "gts": "^3.1.1",
    "jest": "^30.5.2",
    "jest-extended": "^7.0.0",
    "prettier": "^2.7.1",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.14",
    "typescript": "^6.0.3",
    "wrangler": "^4.148.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "celebrate": "^15.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "http-status-codes": "^2.3.0",
    "jsonwebtoken": "^9.0.3",
    "slugify": "^1.6.9"
  },
  "overrides": {
    "celebrate": {
      "lodash": "^4.18.1"
    }
  }
}
